{
  "name": "@dock/api",
  "version": "12.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/seed.ts",
    "test": "vitest run --pool=forks --poolOptions.forks.singleFork"
  },
  "dependencies": {
    "@dock/shared": "*",
    "@fastify/cors": "^9.0.1",
    "fastify": "^4.28.1",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
