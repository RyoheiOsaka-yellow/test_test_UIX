# ---- PostgreSQL / PostGIS / 3DCityDB（公式イメージ 3dcitydb/3dcitydb-pg） ----
CITYDB_IMAGE_TAG=16-3.5-5.1        # PostgreSQL 16, PostGIS 3.5, 3DCityDB 5.1
POSTGRES_DB=citydb
POSTGRES_USER=citydb
POSTGRES_PASSWORD=citydb           # ローカル開発用。必ず変更する
POSTGRES_PORT=5432
SRID=6697                          # JGD2011 + 標高（PLATEAU 姫路市 CityGML と同じ）
SRS_NAME=urn:ogc:def:crs:EPSG::6697
CHANGELOG=no

# ---- 読み取り専用ロール（3DCityDB MCP / Human Flow API）と ETL ロール ----
MCP_DB_USER=citydb_reader
MCP_DB_PASSWORD=citydb_reader
API_DB_USER=citydb_reader
API_DB_PASSWORD=citydb_reader
MOBILITY_WRITER_PASSWORD=mobility_writer

# ---- 3DCityDB MCP Server（SSE）: Claude Code からは stdio 版を推奨（README_DB.md） ----
MCP_PORT=8080

# ---- Human Flow API（FastAPI） ----
API_PORT=8000
API_CORS_ORIGINS=*
API_MAX_POINTS=20000
API_DEFAULT_SOURCE=synthetic       # 画面・API の既定 source（実データ投入後は gps など）

# ---- citydb-tool（PLATEAU 取込, --profile import） ----
CITYDB_TOOL_TAG=1.4
PLATEAU_CITYGML_DIR=../../data/real/citygml

# ---- Claude Code 用 stdio MCP（infra/docker で `claude mcp add 3dcitydb -- 3dcitydb-mcp`）----
CITYDB_HOST=localhost
CITYDB_PORT=5432
CITYDB_NAME=citydb
CITYDB_USER=citydb_reader
CITYDB_PASSWORD=citydb_reader
CITYDB_SCHEMA=citydb

# ---- Jev AI Decision Layer（必須依存ではない。false / timeout / rate limit / key 無し / 障害でも Digital Twin は完全動作） ----
JEV_ENABLED=false
JEV_API_KEY=
JEV_API_URL=                       # 正式 API のエンドポイント（Playground URL を本番として入れない）。空なら http provider は FALLBACK
JEV_PROVIDER=mock                  # mock | http（mock は Interface 検証用の決定論的モック）
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=700
JEV_CONFIDENCE_THRESHOLD=0.65      # これ未満の Choice は UNKNOWN / Local
JEV_CONFIDENCE_HIGH=0.75           # 以上: Jev 採用
JEV_CONFIDENCE_LOW=0.55            # 未満: Local 優先（間は Jev と Local を比較）
JEV_CACHE_TTL_MS=5000
JEV_ANOMALY_WATCH=0.5
JEV_ANOMALY_WARNING=0.7
JEV_ANOMALY_HIGH=0.85
JEV_FPS_SAFETY=25                  # hard safety: これ未満は LOD / Budget を強制的に下げる
JEV_MEMORY_MB_MAX=1500
JEV_TELEMETRY_LOG=                 # 例: /app/telemetry/jev.jsonl（空ならメモリのみ。個人 GPS は記録しない）
