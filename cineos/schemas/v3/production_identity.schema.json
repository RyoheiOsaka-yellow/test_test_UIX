        "null"
      ]
    },
    "scene_id": {
      "type": "string"
    },
    "shot_id": {
      "type": "string"
    },
    "take_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "media_asset_id": {
      "type": [
