  "required": [
    "scene_id",
    "beats",
    "axis",
    "blocking",
    "shots"
  ],
  "properties": {
    "scene_id": {
      "type": "string"
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "axis": {
      "type": "object"
    },
    "blocking": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "lighting_zones": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}